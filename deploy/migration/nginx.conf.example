# Install as zz-multica.conf so an implicit existing default stays first.
# Preserve the existing default_server and vhosts.
# Substitute the hostname, certificate paths, and loopback ports before use.
map $http_upgrade $multica_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name multica.example.com;
    ssl_certificate /etc/nginx/multica/fullchain.pem;
    ssl_certificate_key /etc/nginx/multica/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;

    location /api/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
    location = /ws {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $multica_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
    }
    location /uploads/ {
        # Migrated private files are served by authenticated/capability API URLs.
        return 404;
    }
    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
