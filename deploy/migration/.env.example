# Copy outside tracked files; use new, random secrets and immutable image digests.
COMPOSE_PROJECT_NAME=multica-migration
SYNC_POSTGRES_IMAGE=pgvector/pgvector@sha256:REPLACE
SYNC_BACKEND_IMAGE=ghcr.io/multica-ai/multica-backend@sha256:REPLACE
SYNC_WEB_IMAGE=ghcr.io/multica-ai/multica-web@sha256:REPLACE
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
MULTICA_VCS_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
APP_ENV=production
BACKEND_PORT=18080
FRONTEND_PORT=13000
MULTICA_APP_URL=https://multica.example.com
MULTICA_PUBLIC_URL=https://multica.example.com
CORS_ALLOWED_ORIGINS=https://multica.example.com
ALLOW_SIGNUP=true
ALLOWED_EMAILS=operator@example.com
DISABLE_WORKSPACE_CREATION=true
DO_NOT_TRACK=true
